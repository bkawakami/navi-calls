# ===== Aplicação =====
APP_NAME="Navi"
APP_ENV=development
DEBUG=true
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=troque-esta-chave

HOST=0.0.0.0
PORT=8000

# URL pública alcançável pela Recall.ai (ngrok/cloudflared em dev, Cloud Run em produção).
# A página da assistente (Output Media) e os webhooks usam esta base.
BASE_URL=http://localhost:8000

# ===== MongoDB =====
MONGODB_URL=mongodb://localhost:27027
MONGODB_DB_NAME=navi

# ===== Painel (opcional) =====
# Se preenchido, o painel e as APIs do painel exigem HTTP Basic (usuário/senha).
DASHBOARD_USER=navi
DASHBOARD_PASSWORD=

# ===== Recall.ai =====
# Cadastro pay-as-you-go: https://us-west-2.recall.ai/auth/signup (ou eu-central-1 / ap-northeast-1).
# Chave: https://<regiao>.recall.ai/dashboard/developers/api-keys (a chave é por região).
RECALL_API_KEY=
RECALL_REGION=us-west-2
# Segredo de verificação (whsec_...): "Create Workspace Secret" em Developers > API Keys & Secrets.
# Vale para os webhooks de status (dashboard) e para os webhooks em tempo real.
RECALL_WEBHOOK_SECRET=
# Segredo extra embutido na URL dos webhooks em tempo real (?secret=). Gere um valor aleatório.
RECALL_REALTIME_SECRET=
RECALL_BOT_NAME="Navi | Assistente IA"
RECALL_BOT_VARIANT=web_4_core
# recallai_streaming: sem chave extra; português só no modo de precisão (transcrição chega 3-10 min depois).
# deepgram_streaming: tempo real em pt-BR; exige chave Deepgram cadastrada no dashboard da Recall (Transcription > Deepgram).
# none: sem transcrição da Recall (painel e ata usam a transcrição da OpenAI, sem nome dos falantes).
RECALL_TRANSCRIPT_PROVIDER=recallai_streaming
RECALL_TRANSCRIPT_LANGUAGE=pt
RECALL_POLL_SECONDS=10

# ===== OpenAI =====
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_REASONING=low
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
OPENAI_TURN_DETECTION=server_vad
OPENAI_VAD_SILENCE_MS=700
OPENAI_TEXT_MODEL=gpt-5.6-sol
OPENAI_TEXT_MODEL_FALLBACKS=gpt-5.5,gpt-5.4-mini
OPENAI_TEXT_REASONING=medium
OPENAI_EPHEMERAL_TTL_SECONDS=600

# ===== Assistente =====
NAVI_WAKE_WORDS=navi,návi,naví,navy,nabi,navie,navvy
NAVI_MAX_ANSWER_SECONDS=25
# auto = WebRTC com fallback automático para WebSocket; websocket força o fallback (se o bot bloquear UDP)
NAVI_TRANSPORT=auto
